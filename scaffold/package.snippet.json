{
  "//": "このスニペットを既存の package.json にマージしてください（そのまま置き換えない）。",
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:light": "playwright test --project=chromium",
    "e2e:heavy": "playwright test --project=chromium-heavy --pass-with-no-tests",
    "e2e:happy": "playwright test --grep @class:happy",
    "e2e:network": "playwright test --grep @class:network",
    "e2e:report": "playwright show-report e2e/.report",
    "e2e:merge": "playwright merge-reports --config playwright.config.ts --reporter html,junit e2e/.blob",
    "e2e:update-snapshots": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "dotenv": "^16.4.0"
  }
}
