# e2e-planner scaffold の環境変数テンプレート。
# このファイルをコピーして .env を作り、実値を入れる（.env はコミットしない）:
#   cp .env.example .env
# playwright.config.ts が先頭で dotenv を読むので、.env があれば自動で反映される
# （無くても CI 等の実環境変数で動く。手動 export は不要）。

# テスト対象のベースURL（playwright.config.ts の baseURL が参照）
E2E_BASE_URL=http://localhost:3000

# 認証モード（playwright.config.ts の projects 構成を切り替える）
#   form           = auth.setup.ts が form ログインして storageState を自動生成（既定）
#                    採取は cookie/localStorage/IndexedDB の3種を自動カバー（Firebase 等の IndexedDB 認証も対応・要 Playwright 1.51+）
#   prebuilt-state = SSO/OTP 等で手動採取した e2e/.auth/user.json を使う（setup を組まない）
#   none           = 認証不要（storageState を持たない）
E2E_AUTH_MODE=form

# 認証セットアップ（auth.setup.ts）が使うログイン情報（form モードで使用）。
# デフォルト値は無い。空欄のままだと auth.setup.ts が setup 実行時に fail-fast する
# （未ログイン導線のみなら --project=chromium-guest、SSO/OTP なら E2E_AUTH_MODE=prebuilt-state）。
E2E_USER=
E2E_PASS=

# admin など別ロールを足す場合の例:
# E2E_ADMIN_USER=admin@example.com
# E2E_ADMIN_PASS=password

# ── 実行制御（playwright.config.ts が参照。空欄 = config の既定）─────────────
# リトライ回数。既定 0（CI でも 0）。retry は flaky を隠し、破壊的テストの初回試行分が残骸になるため、
# flaky は e2e-run の無修正3回再評価で診断する。どうしても必要なときだけ数値を入れる。
E2E_RETRIES=

# 並列 worker 数。未設定なら config の既定（CI=1 / ローカル=CPU 依存）。
# 隔離データ（plan の data.own=self）と worker 別アカウント（E2E_USER_POOL）が揃ってから上げる。
E2E_WORKERS=

# trace の採取モード（off | on | retain-on-failure | on-first-retry | on-all-retries | retain-on-first-failure）。
# 既定 retain-on-failure。監査で全件残すなら on。
E2E_TRACE=

# video の採取モード（off | on | retain-on-failure | on-first-retry）。既定 retain-on-failure。
E2E_VIDEO=

# user ロールの storageState パス。既定 e2e/.auth/user.json。
# CI では Secure File 等から展開した採取済み state のパスを渡す（E2E_AUTH_MODE=prebuilt-state と組み合わせる）。
E2E_STORAGE_STATE=

# worker ごとに別アカウントを使うときのプール（`mail:pass,mail:pass,...`、同一ロール、form モード専用）。
# spec の import を e2e/fixtures/test.ts に切り替えると parallelIndex で割り当てる。アカウント数が並列度の上限。
E2E_USER_POOL=
